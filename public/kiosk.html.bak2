<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Plane-Zone</title>
<style>
:root{
  --bg:#0b0b0c;
  --fg:#f2f2f2;
  --muted:#8a8a8a;
  --line:#2a2a2a;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  background:var(--bg);
  color:var(--fg);
  font-family:"IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  overflow:hidden;
}

.screen{display:none;height:100%;padding:18px}
.screen.active{display:flex;flex-direction:column;justify-content:center;align-items:center}

/* CLOCK */
.board{display:flex;align-items:center;gap:8px}
.flap{width:70px;height:96px;position:relative;perspective:700px}
.flap .face{
  position:absolute; inset:0;
  background:#111;
  border:1px solid var(--line);
  border-radius:10px;
  display:flex; align-items:center; justify-content:center;
  font-weight:800; font-size:64px; line-height:1;
  will-change:transform;
}
.flap .top{clip-path:inset(0 0 50% 0)}
.flap .bottom{clip-path:inset(50% 0 0 0)}
.flap .flip{
  position:absolute; inset:0;
  transform-origin:bottom;
  animation:flip .38s ease-out;
  will-change:transform;
}
@keyframes flip{from{transform:rotateX(0deg)} to{transform:rotateX(-180deg)}}

.colon{
  font-size:54px;
  padding:0 2px;
  transform:translateY(-4px);
  opacity:1;
  transition:opacity .18s linear;
}
.colon.blink{opacity:.12}

.date{
  margin-top:18px;
  font-size:14px;
  letter-spacing:.18em;
  color:var(--muted);
}

.btnrow{display:flex; gap:10px; margin-top:22px}
button{
  background:transparent;
  border:1px solid var(--line);
  color:var(--fg);
  padding:10px 18px;
  border-radius:10px;
  font-family:inherit;
  letter-spacing:.14em;
}

/* PLANE ANIMATION (clock overlay) */
.planeStage{
  position:absolute;
  left:0; right:0;
  top:54%;
  height:56px;
  pointer-events:none;
  overflow:hidden;
}
.plane{
  position:absolute;
  top:10px;
  left:-120px;
  width:96px;
  height:36px;
  opacity:0;
  filter: drop-shadow(0 10px 16px rgba(0,0,0,.65));
}
.plane.fly{
  opacity:1;
  animation:fly 4.8s ease-in-out forwards;
}
@keyframes fly{
  0%{transform:translateX(-140px)}
  100%{transform:translateX(calc(100vw + 220px))}
}

/* FLIGHT SCREEN (airport board + details) */
.flight-wrap{
  width:100%;
  max-width:420px;
  display:flex;
  flex-direction:column;
  gap:12px;
}

.routeRow{
  cursor:pointer;
  user-select:none;
  padding:14px 12px;
  border:1px solid var(--line);
  border-radius:14px;
  background:rgba(255,255,255,.02);
}

.routeTop{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:12px;
}
.bigRoute{
  font-size:44px;
  font-weight:900;
  letter-spacing:.10em;
  line-height:1;
}
.rightStack{
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:6px;
  margin-top:2px;
}
.topCallsign{
  font-size:18px;
  font-weight:900;
  letter-spacing:.14em;
}
.modelTag{
  font-size:16px;
  color:var(--muted);
  letter-spacing:.12em;
  font-weight:800;
}
.airlineLine{
  margin-top:10px;
  font-size:12px;
  color:var(--muted);
  letter-spacing:.10em;
  min-height:16px;
}

.details{
  display:none;
  width:100%;
  border:1px solid var(--line);
  border-radius:14px;
  background:rgba(255,255,255,.02);
  padding:12px;
}
.details.active{display:block}

.meta{
  font-size:12px;
  color:var(--muted);
  line-height:1.55;
}
.meta b{color:var(--fg); font-weight:800}

.routeLines{
  margin-top:10px;
  padding-top:10px;
  border-top:1px solid var(--line);
  display:flex;
  gap:10px;
  align-items:flex-start;
  justify-content:space-between;
}
.routeLines .side{width:45%; font-size:12px; color:var(--muted)}
.routeLines .side b{
  display:block;
  font-size:13px;
  color:var(--fg);
  letter-spacing:.02em;
  margin-top:3px;
}
.arrow{color:var(--muted); font-size:16px; transform:translateY(18px)}
.err{
  font-size:12px;
  color:#ffb4b4;
  letter-spacing:.10em;
  text-align:right;
  min-height:16px;
}
</style>
</head>

<body>

<!-- CLOCK -->
<section id="clock" class="screen active">
  <div class="board" aria-label="clock">
    <div class="flap"></div><div class="flap"></div>
    <div class="colon" id="c1">:</div>
    <div class="flap"></div><div class="flap"></div>
  </div>

  <div class="date" id="date"></div>

  <div class="btnrow">
    <button id="btnShow">SHOW FLIGHT</button>
  </div>
</section>

<!-- Plane animation overlay (shown on clock) -->
<div class="planeStage" aria-hidden="true">
  <!-- cleaner airplane silhouette -->
  <svg class="plane" id="planeSvg" viewBox="0 0 120 40">
    <path fill="#f2f2f2" d="M4 22c0-1.6 1.3-3 3-3h28l20-16c1.1-.9 2.5-1.4 3.9-1.4H66c1.5 0 2.9.8 3.7 2L83 17h30c4.1 0 7 2.5 7 6s-2.9 6-7 6H83l-13.3 13.2c-.8 1.2-2.2 2-3.7 2h-7.1c-1.4 0-2.8-.5-3.9-1.4L35 27H7c-1.7 0-3-1.3-3-3zm40-3 14 12h7.2l9.8-8.5V18H65.2L58 9.5h-4.6L44 19z"/>
    <path fill="#f2f2f2" opacity=".9" d="M26 25l14 11h-8l-18-11z"/>
    <path fill="#f2f2f2" opacity=".9" d="M26 15l14-11h-8L14 15z"/>
  </svg>
</div>

<!-- FLIGHT -->
<section id="flight" class="screen">
  <div class="flight-wrap">

    <div class="routeRow" id="routeRow" title="Apri dettagli">
      <div class="routeTop">
        <div class="bigRoute" id="iataRoute">--- → ---</div>

        <div class="rightStack">
          <div class="topCallsign" id="topCallsign">—</div>
          <div class="modelTag" id="topModel">—</div>
        </div>
      </div>

      <div class="airlineLine" id="topAirline">—</div>
      <div class="err" id="flightErr"></div>
    </div>

    <div class="details" id="details">
      <div class="meta">
        <div>Callsign: <b id="flightCallsign">—</b></div>
        <div>Airline: <b id="flightAirline">—</b></div>
      </div>

      <div class="routeLines">
        <div class="side">
          DA
          <b id="fromTxt">N/D</b>
        </div>
        <div class="arrow">➜</div>
        <div class="side" style="text-align:right">
          A
          <b id="toTxt">N/D</b>
        </div>
      </div>

      <div class="btnrow" style="justify-content:space-between; margin-top:12px;">
        <button id="btnBack">BACK</button>
        <button id="btnRefresh">AGGIORNA</button>
      </div>
    </div>

    <div class="btnrow" id="bottomBtns" style="justify-content:space-between">
      <button id="btnBack2">BACK</button>
      <button id="btnRefresh2">AGGIORNA</button>
    </div>

  </div>
</section>

<script>
const $ = (id)=>document.getElementById(id);

// ----- Screen switching -----
const clockEl = $("clock");
const flightEl = $("flight");
$("btnShow").onclick = () => { showFlight(); refreshFlight(); };
$("btnBack").onclick = () => showClock();
$("btnBack2").onclick = () => showClock();
$("btnRefresh").onclick = () => refreshFlight();
$("btnRefresh2").onclick = () => refreshFlight();
$("routeRow").onclick = () => toggleDetails();

function showFlight(){ clockEl.classList.remove("active"); flightEl.classList.add("active"); }
function showClock(){ flightEl.classList.remove("active"); clockEl.classList.add("active"); closeDetails(); }

function openDetails(){ $("details").classList.add("active"); $("bottomBtns").style.display="none"; }
function closeDetails(){ $("details").classList.remove("active"); $("bottomBtns").style.display="flex"; }
function toggleDetails(){ $("details").classList.contains("active") ? closeDetails() : openDetails(); }

// ----- CLOCK -----
function makeFace(n, cls){
  const d=document.createElement("div");
  d.className="face " + cls;
  d.textContent=n;
  return d;
}
const flaps=[...document.querySelectorAll(".flap")];
let last="";
function setFlap(flap, from, to){
  flap.replaceChildren(
    makeFace(from || to, "top"),
    makeFace(to, "bottom"),
    makeFace(from || to, "flip")
  );
}
function tick(){
  const d=new Date();
  const h=String(d.getHours()).padStart(2,"0");
  const m=String(d.getMinutes()).padStart(2,"0");
  const now = h+m;

  if(now !== last){
    for(let i=0;i<now.length;i++){
      if(last[i] !== now[i]){
        setFlap(flaps[i], last[i], now[i]);
      }
    }
    last = now;
  }
  $("c1").classList.toggle("blink", d.getSeconds()%2===0);
  $("date").textContent =
    d.toLocaleDateString("it-IT",{weekday:"short",day:"2-digit",month:"short",year:"numeric"}).toUpperCase();
}
setInterval(tick, 1000);
tick();

// ----- Flight data helpers -----
function fmtAirport(x){
  if(!x) return "N/D";
  const m = x.municipality || "—";
  const n = x.name || "—";
  const i = x.iata || x.iata_code || "";
  return i ? `${m} — ${n} (${i})` : `${m} — ${n}`;
}
function getIata(x){
  return (x && (x.iata || x.iata_code)) ? (x.iata || x.iata_code) : "---";
}
function cleanAirlineName(name){
  if(!name) return "—";
  const n = String(name).trim();
  const bad = ["transit", "company", "unknown", "n/a", "generic"];
  if(bad.some(w => n.toLowerCase().includes(w))) return "—";
  return n;
}

// Fill Flight UI from a plane object (shared by refresh + auto reveal)
function applyPlaneToFlightUI(p){
  const oi = getIata(p.from);
  const di = getIata(p.to);
  const cs = (p.callsign_iata || p.callsign || "—");
  const model = (p.aircraft_model || "—");
  const airline = cleanAirlineName(p.airline_name);

  $("iataRoute").textContent = `${oi} → ${di}`;
  $("topCallsign").textContent = cs;
  $("topModel").textContent = model;
  $("topAirline").textContent = airline;

  $("flightCallsign").textContent = cs;
  $("flightAirline").textContent = airline;
  $("fromTxt").textContent = fmtAirport(p.from);
  $("toTxt").textContent = fmtAirport(p.to);
}

// ----- Refresh flight (manual / show flight) -----
let rotateIdx = 0;
function pickFeatured(planes){
  if(!planes || !planes.length) return null;
  const rich = planes.filter(p => p.from && p.to);
  const list = rich.length ? rich : planes;
  const pck = list[rotateIdx % list.length];
  rotateIdx = (rotateIdx + 1) % list.length;
  return pck;
}

async function refreshFlight(){
  $("flightErr").textContent = "";
  try{
    const r = await fetch("/api/planes", { cache:"no-store" });
    if(!r.ok) throw new Error("API error");
    const planes = await r.json();
    const p = pickFeatured(planes);

    if(!p){
      $("flightErr").textContent = "NESSUN AEREO";
      $("iataRoute").textContent = "--- → ---";
      $("topCallsign").textContent = "—";
      $("topModel").textContent = "—";
      $("topAirline").textContent = "—";
      $("flightCallsign").textContent = "—";
      $("flightAirline").textContent = "—";
      $("fromTxt").textContent = "N/D";
      $("toTxt").textContent = "N/D";
      closeDetails();
      return;
    }

    applyPlaneToFlightUI(p);

  }catch(e){
    $("flightErr").textContent = "ERR";
  }
}

// ----- Auto-detect on clock: animate plane then open flight page -----
let isAnimating = false;
let lastSeenKey = "";

function planeKey(p){
  return [
    p.callsign_iata || "",
    p.callsign || "",
    getIata(p.from),
    getIata(p.to),
    p.aircraft_model || ""
  ].join("|");
}

function runPlaneAnimationThenOpen(p){
  const plane = $("planeSvg");
  isAnimating = true;

  // restart CSS animation
  plane.classList.remove("fly");
  void plane.offsetWidth;
  plane.classList.add("fly");

  // halfway through the flight, switch to FLIGHT and show data
  setTimeout(() => {
    applyPlaneToFlightUI(p);
    showFlight();
    isAnimating = false;
  }, 2400); // half of 4.8s
}

async function pollPlanes(){
  // only poll while on clock
  if(!clockEl.classList.contains("active")) return;
  if(isAnimating) return;

  try{
    const r = await fetch("/api/planes", { cache:"no-store" });
    if(!r.ok) return;
    const planes = await r.json();
    const p = pickFeatured(planes);
    if(!p) return;

    const key = planeKey(p);
    if(key && key !== lastSeenKey){
      lastSeenKey = key;
      runPlaneAnimationThenOpen(p);
    }
  }catch(e){
    // ignore on clock
  }
}

// first check after 8s, then every 60s
setTimeout(pollPlanes, 8000);
setInterval(pollPlanes, 60000);
</script>

</body>
</html>
