<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Plane-Zone</title>

<style>
:root{
  --bg:#0b0b0c;
  --fg:#f2f2f2;
  --muted:#8a8a8a;
  --line:#2a2a2a;
  --panel:rgba(255,255,255,.02);
}
*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  background:var(--bg);
  color:var(--fg);
  font-family:"IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  overflow:hidden;
}
.screen{display:none;height:100%;padding:18px}
.screen.active{display:flex;flex-direction:column;justify-content:center;align-items:center}

/* ---------- CLOCK (flaps) ---------- */
.board{display:flex;align-items:center;gap:8px}
.flap{width:70px;height:96px;position:relative;perspective:700px}
.flap .face{
  position:absolute; inset:0;
  background:#111;
  border:1px solid var(--line);
  border-radius:10px;
  display:flex; align-items:center; justify-content:center;
  font-weight:900; font-size:64px; line-height:1;
  will-change:transform;
}
.flap .top{clip-path:inset(0 0 50% 0)}
.flap .bottom{clip-path:inset(50% 0 0 0)}
.flap .flip{
  position:absolute; inset:0;
  transform-origin:bottom;
  animation:flip .38s ease-out;
  will-change:transform;
}
@keyframes flip{from{transform:rotateX(0deg)} to{transform:rotateX(-180deg)}}
.colon{
  font-size:54px;
  padding:0 2px;
  transform:translateY(-4px);
  opacity:1;
  transition:opacity .18s linear;
}
.colon.blink{opacity:.12}
.date{
  margin-top:18px;
  font-size:14px;
  letter-spacing:.18em;
  color:var(--muted);
}
.btnrow{display:flex;gap:10px;margin-top:22px;width:100%;justify-content:center}
button{
  background:transparent;
  border:1px solid var(--line);
  color:var(--fg);
  padding:10px 18px;
  border-radius:12px;
  font-family:inherit;
  letter-spacing:.14em;
}

/* ---------- Plane animation OVER the clock ---------- */
.planeStage{
  position:fixed;
  inset:0;
  pointer-events:none;
  overflow:hidden;
  z-index:9999;
}
.planeLane{
  position:absolute;
  left:0; right:0;
  top:50%;
  transform:translateY(-64px); /* quota sopra i flap */
  height:120px;
}
.plane{
  position:absolute;
  top:0;
  left:-220px;
  width:120px;
  height:120px;
  opacity:0;
  filter: drop-shadow(0 10px 18px rgba(0,0,0,.55));
}
.plane.fly{
  opacity:1;
  animation:fly 6.5s linear forwards;
}
@keyframes fly{
  0%{transform:translateX(-220px)}
  100%{transform:translateX(calc(100vw + 260px))}
}

/* ---------- FLIGHT screen ---------- */
.flight-wrap{
  width:100%;
  max-width:420px;
  display:flex;
  flex-direction:column;
  gap:12px;
}

.routeRow{
  cursor:pointer;
  user-select:none;
  padding:14px 12px;
  border:1px solid var(--line);
  border-radius:14px;
  background:var(--panel);
}
.routeTop{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:12px;
  

  align-items:center;
  flex-wrap:nowrap;
}


/* Route flaps (IATA) */
.routeFlaps{display:flex;align-items:center;gap:6px;max-width:100%;flex:1 1 240px
  flex:1 1 auto;
  min-width:0;
}

.rflap{
  width:52px;height:70px;
  background:#111;
  border:1px solid var(--line);
  border-radius:10px;
  display:flex;align-items:center;justify-content:center;
}
.rface{
  font-weight:900;
  font-size:46px;
  line-height:1;
  letter-spacing:.06em;
}
.rarrow{
  font-size:38px;
  margin:0 10px;
  transform:translateY(-2px);
  opacity:.9;
}

.rightStack{
  display:flex;
  flex-direction:column;
  align-items:flex-end;
  gap:6px;
  margin-top:2px;
  flex:0 0 auto;
  min-width:72px;
  max-width:110px;

  flex:0 0 auto;
  white-space:nowrap;
}

.topCallsign{
  font-size:14px;
  font-weight:900;
  letter-spacing:.06em;
}


.modelTag{
  font-size:13px;
  letter-spacing:.05em;
}



.airlineLine{
  margin-top:10px;
  font-size:12px;
  color:var(--muted);
  letter-spacing:.10em;
  min-height:16px;
}
.err{
  font-size:12px;
  color:#ffb4b4;
  letter-spacing:.10em;
  text-align:right;
  min-height:16px;
}

.details{
  display:none;
  width:100%;
  border:1px solid var(--line);
  border-radius:14px;
  background:var(--panel);
  padding:12px;
}
.details.active{display:block}
.meta{
  font-size:12px;
  color:var(--muted);
  line-height:1.55;
}
.meta b{color:var(--fg); font-weight:900}

.routeLines{
  margin-top:10px;
  padding-top:10px;
  border-top:1px solid var(--line);
  display:flex;
  gap:10px;
  align-items:flex-start;
  justify-content:space-between;
}
.routeLines .side{width:45%; font-size:12px; color:var(--muted)}
.routeLines .side b{
  display:block;
  font-size:13px;
  color:var(--fg);
  letter-spacing:.02em;
  margin-top:3px;
}
.arrow2{color:var(--muted); font-size:16px; transform:translateY(18px)}

/* Small screens (Pi 320x480) */
@media (max-width: 380px){
  .flap{width:62px;height:88px}
  .flap .face{font-size:60px}
  .rflap{width:44px;height:60px}
  .rface{font-size:40px}
  .rarrow{font-size:34px;margin:0 8px}
  .topCallsign{font-size:16px}
  .modelTag{font-size:14px}
}
</style>
</head>

<body>

<!-- CLOCK -->
<section id="clock" class="screen active">
  <div class="board" aria-label="clock">
    <div class="flap"></div><div class="flap"></div>
    <div class="colon" id="c1">:</div>
    <div class="flap"></div><div class="flap"></div>
  </div>
  <div class="date" id="date"></div>

  <div class="btnrow">
    <button id="btnShow">SHOW FLIGHT</button>
  </div>
</section>

<!-- plane overlay -->
<div class="planeStage" aria-hidden="true">
  <div class="planeLane">
    <!-- top-down silhouette white -->
    <svg class="plane" id="planeSvg" viewBox="0 0 128 128">
      <path fill="#ffffff" d="M62 6c-7 0-12 6-12 13v26L16 60c-2 1-3 3-3 5v8c0 2 2 4 4 4l33-6v20L35 103c-1 1-2 2-2 4v7c0 2 2 4 4 3l25-9v12c0 4 3 8 6 8s6-4 6-8v-12l25 9c2 1 4-1 4-3v-7c0-2-1-3-2-4L78 91V71l33 6c2 0 4-2 4-4v-8c0-2-1-4-3-5L78 45V19c0-7-5-13-12-13zm0 52c2 0 4 2 4 4s-2 4-4 4-4-2-4-4 2-4 4-4z"/>
    </svg>
  </div>
</div>

<!-- FLIGHT -->
<section id="flight" class="screen">
  <div class="flight-wrap">

    <div class="routeRow" id="routeRow" title="Apri dettagli">
      <div class="routeTop">

        <div class="routeFlaps" id="routeFlaps">
          <div class="rflap"><div class="rface" id="o0">-</div></div>
          <div class="rflap"><div class="rface" id="o1">-</div></div>
          <div class="rflap"><div class="rface" id="o2">-</div></div>
          <div class="rarrow">→</div>
          <div class="rflap"><div class="rface" id="d0">-</div></div>
          <div class="rflap"><div class="rface" id="d1">-</div></div>
          <div class="rflap"><div class="rface" id="d2">-</div></div>
        </div>

        <div class="rightStack">
          <div class="topCallsign" id="topCallsign">—</div>
          <div class="modelTag" id="topModel">—</div>
        </div>

      </div>

      <div class="airlineLine" id="topAirline">—</div>
      <div class="err" id="flightErr"></div>
    </div>

    <div class="details" id="details">
      <div class="meta">
        <div>Callsign: <b id="flightCallsign">—</b></div>
        <div>Airline: <b id="flightAirline">—</b></div>
      </div>

      <div class="routeLines">
        <div class="side">
          DA
          <b id="fromTxt">N/D</b>
        </div>
        <div class="arrow2">➜</div>
        <div class="side" style="text-align:right">
          A
          <b id="toTxt">N/D</b>
        </div>
      </div>

      <div class="btnrow" style="justify-content:space-between; margin-top:12px;">
        <button id="btnBack">BACK</button>
        <button id="btnRefresh">AGGIORNA</button>
      </div>
    </div>

    <div class="btnrow" id="bottomBtns" style="justify-content:space-between">
      <button id="btnBack2">BACK</button>
      <button id="btnRefresh2">AGGIORNA</button>
    </div>

  </div>
</section>

<script>
const $ = (id)=>document.getElementById(id);

/* ---------- screens ---------- */
const clockEl = $("clock");
const flightEl = $("flight");

$("btnShow").onclick = () => { showFlight(); refreshFlight(); };

$("btnBack").onclick = () => showClock();
$("btnBack2").onclick = () => showClock();
$("btnRefresh").onclick = () => refreshFlight();
$("btnRefresh2").onclick = () => refreshFlight();
$("routeRow").onclick = () => toggleDetails();

function showFlight(){ clockEl.classList.remove("active"); flightEl.classList.add("active"); }
function showClock(){ flightEl.classList.remove("active"); clockEl.classList.add("active"); closeDetails(); }

function openDetails(){ $("details").classList.add("active"); $("bottomBtns").style.display="none"; }
function closeDetails(){ $("details").classList.remove("active"); $("bottomBtns").style.display="flex"; }
function toggleDetails(){ $("details").classList.contains("active") ? closeDetails() : openDetails(); }

/* ---------- clock logic ---------- */
function makeFace(n, cls){
  const d=document.createElement("div");
  d.className="face " + cls;
  d.textContent=n;
  return d;
}
const flaps=[...document.querySelectorAll(".flap")];
let last="";
function setFlap(flap, from, to){
  flap.replaceChildren(
    makeFace(from || to, "top"),
    makeFace(to, "bottom"),
    makeFace(from || to, "flip")
  );
}
function tick(){
  const d=new Date();
  const h=String(d.getHours()).padStart(2,"0");
  const m=String(d.getMinutes()).padStart(2,"0");
  const now = h+m;

  if(now !== last){
    for(let i=0;i<now.length;i++){
      if(last[i] !== now[i]){
        setFlap(flaps[i], last[i], now[i]);
      }
    }
    last = now;
  }
  $("c1").classList.toggle("blink", d.getSeconds()%2===0);
  $("date").textContent =
    d.toLocaleDateString("it-IT",{weekday:"short",day:"2-digit",month:"short",year:"numeric"}).toUpperCase();
}
setInterval(tick, 1000);
tick();

/* ---------- helpers ---------- */
function getIata(x){
  return (x && (x.iata || x.iata_code)) ? (x.iata || x.iata_code) : "---";
}
function setRouteFlaps(o,d){
  const O=(o||"---").padEnd(3,"-").slice(0,3).toUpperCase();
  const D=(d||"---").padEnd(3,"-").slice(0,3).toUpperCase();
  for(let i=0;i<3;i++){
    const oe = document.getElementById("o"+i);
    const de = document.getElementById("d"+i);
    if(oe) oe.textContent = O[i];
    if(de) de.textContent = D[i];
  }
}
function fmtAirport(x){
  if(!x) return "N/D";
  const m = x.municipality || "—";
  const n = x.name || "—";
  const i = x.iata || x.iata_code || "";
  return i ? `${m} — ${n} (${i})` : `${m} — ${n}`;
}
function cleanAirlineName(name){
  if(!name) return "—";
  const n = String(name).trim();
  const bad = ["transit","company","unknown","n/a","generic"];
  if(bad.some(w => n.toLowerCase().includes(w))) return "—";
  return n;
}

/* ---------- apply plane to UI ---------- */
function applyPlaneToFlightUI(p){
  // IMPORTANT: se abbiamo un plane, l’errore va sempre pulito
  $("flightErr").textContent = "";

  const oi = getIata(p.from);
  const di = getIata(p.to);
  const cs = (p.callsign_iata || p.callsign || "—");
  const model = (p.aircraft_model || "—");
  const airline = cleanAirlineName(p.airline_name);

  setRouteFlaps(oi, di);
  $("topCallsign").textContent = cs;
  $("topModel").textContent = model;
  $("topAirline").textContent = airline;

  $("flightCallsign").textContent = cs;
  $("flightAirline").textContent = airline;
  $("fromTxt").textContent = fmtAirport(p.from);
  $("toTxt").textContent = fmtAirport(p.to);
}

/* ---------- fetch logic ---------- */
let rotateIdx = 0;
function pickFeatured(planes){
  if(!planes || !planes.length) return null;
  const rich = planes.filter(p => p.from && p.to);
  const list = rich.length ? rich : planes;
  const pck = list[rotateIdx % list.length];
  rotateIdx = (rotateIdx + 1) % list.length;
  return pck;
}

async function refreshFlight(){
  try{
    const r = await fetch("/api/planes", { cache:"no-store" });
    if(!r.ok) throw new Error("API error");
    const planes = await r.json();
    const p = pickFeatured(planes);

    if(!p){
      // qui ha senso mostrare NESSUN AEREO
      $("flightErr").textContent = "NESSUN AEREO";
      setRouteFlaps("---","---");
      $("topCallsign").textContent = "—";
      $("topModel").textContent = "—";
      $("topAirline").textContent = "—";
      $("flightCallsign").textContent = "—";
      $("flightAirline").textContent = "—";
      $("fromTxt").textContent = "N/D";
      $("toTxt").textContent = "N/D";
      closeDetails();
      return;
    }

    applyPlaneToFlightUI(p);

  }catch(e){
    $("flightErr").textContent = "ERR";
  }
}

/* ---------- auto detect on clock ---------- */
let isAnimating = false;
let lastSeenKey = "";

function planeKey(p){
  return [
    p.callsign_iata || "",
    p.callsign || "",
    getIata(p.from),
    getIata(p.to),
    p.aircraft_model || ""
  ].join("|");
}

function runPlaneAnimationThenOpen(p){
  const plane = $("planeSvg");
  isAnimating = true;

  plane.classList.remove("fly");
  void plane.offsetWidth;
  plane.classList.add("fly");

  // a metà animazione apri Flight con dati
  setTimeout(() => {
    applyPlaneToFlightUI(p);
    showFlight();
    isAnimating = false;
  }, 3250); // metà di 6.5s
}

async function pollPlanes(){
  if(!clockEl.classList.contains("active")) return;
  if(isAnimating) return;

  try{
    const r = await fetch("/api/planes", { cache:"no-store" });
    if(!r.ok) return;
    const planes = await r.json();
    const p = pickFeatured(planes);
    if(!p) return;

    const key = planeKey(p);
    if(key && key !== lastSeenKey){
      lastSeenKey = key;
      runPlaneAnimationThenOpen(p);
    }
  }catch(e){
    // ignore
  }
}

// init defaults
setRouteFlaps("---","---");

// first check after 8s, then every 60s
setTimeout(pollPlanes, 8000);
setInterval(pollPlanes, 60000);
</script>

</body>
</html>
